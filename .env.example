# Password required to open the admin dashboard (change this!)
ADMIN_PASSWORD=change-me

# Long random string used to sign the admin session cookie (change this!)
SESSION_SECRET=change-me-too

# KV_REST_API_URL and KV_REST_API_TOKEN are injected automatically by Vercel
# once a KV store is attached to the project (Storage tab -> Create Database
# -> KV -> Connect to Project). Nothing to set manually there. Without them,
# the app falls back to an in-memory store, which is fine for local dev only.
