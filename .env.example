# Port the server listens on
PORT=3000

# Password required to open the admin dashboard (change this!)
ADMIN_PASSWORD=change-me

# Long random string used to sign the admin session cookie (change this!)
SESSION_SECRET=change-me-too

# PostgreSQL connection string (Render provides this automatically when the
# database is linked via render.yaml — set manually only for local dev)
DATABASE_URL=postgres://user:password@localhost:5432/itex_attendance
